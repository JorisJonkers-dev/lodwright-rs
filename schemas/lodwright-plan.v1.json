{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan",
  "description": "Plan v1. It holds numbers and relative output names only: no game content, no absolute path from the data\nfolder.",
  "type": "object",
  "properties": {
    "arguments_digest": {
      "description": "SHA-256 of the normalised arguments.",
      "type": "string"
    },
    "capabilities": {
      "description": "What `generate` can do today.",
      "$ref": "#/$defs/Capabilities"
    },
    "contract": {
      "description": "The contract name, `lodwright-plan`: a reader refuses a document that names another.",
      "type": "string",
      "const": "lodwright-plan"
    },
    "inputs_digest": {
      "description": "SHA-256 over the sizes and contents of the plugins, in load order (never the content itself).",
      "type": "string"
    },
    "schema_version": {
      "description": "The document version; 1.",
      "type": "integer",
      "format": "uint32",
      "const": 1,
      "minimum": 0
    },
    "tool": {
      "description": "The tool that printed this plan.",
      "$ref": "#/$defs/ToolInfo"
    },
    "warnings": {
      "description": "Human-readable remarks.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "worlds": {
      "description": "One entry per selected world.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/WorldPlan"
      }
    }
  },
  "required": [
    "schema_version",
    "contract",
    "tool",
    "arguments_digest",
    "inputs_digest",
    "capabilities",
    "worlds"
  ],
  "$defs": {
    "Bounds": {
      "description": "Inclusive cell bounds of a world.",
      "type": "object",
      "properties": {
        "east": {
          "description": "Largest cell x.",
          "type": "integer",
          "format": "int32"
        },
        "north": {
          "description": "Largest cell y.",
          "type": "integer",
          "format": "int32"
        },
        "south": {
          "description": "Smallest cell y.",
          "type": "integer",
          "format": "int32"
        },
        "west": {
          "description": "Smallest cell x.",
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "west",
        "south",
        "east",
        "north"
      ]
    },
    "Capabilities": {
      "description": "What `generate` can do today.",
      "type": "object",
      "properties": {
        "object_lod": {
          "description": "Writes object LOD (`.nif` blocks and the atlas).",
          "type": "boolean"
        },
        "settings": {
          "description": "Writes the LOD settings file.",
          "type": "boolean"
        },
        "terrain_mesh": {
          "description": "Writes terrain meshes (`.nif`).",
          "type": "boolean"
        },
        "terrain_texture": {
          "description": "Writes terrain textures.",
          "type": "boolean"
        },
        "tree_lod": {
          "description": "Writes tree LOD.",
          "type": "boolean"
        }
      },
      "required": [
        "terrain_mesh",
        "terrain_texture",
        "settings",
        "object_lod",
        "tree_lod"
      ]
    },
    "LevelPlan": {
      "description": "Totals of one level of one world.",
      "type": "object",
      "properties": {
        "blocks": {
          "description": "Blocks at this level.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "level": {
          "description": "Cells per block edge.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_error": {
          "description": "Largest height error over all blocks, in world units.",
          "type": "number",
          "format": "double"
        },
        "triangles": {
          "description": "Triangles over all blocks.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "vertices": {
          "description": "Vertices over all blocks.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "level",
        "blocks",
        "vertices",
        "triangles",
        "max_error"
      ]
    },
    "PlannedBlock": {
      "description": "One planned block: present only with `--blocks`. Names are relative to the output folder.",
      "type": "object",
      "properties": {
        "diffuse": {
          "description": "Relative path of the diffuse texture.",
          "type": "string"
        },
        "level": {
          "description": "Cells per block edge.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_error": {
          "description": "Height error of the block, in world units.",
          "type": "number",
          "format": "double"
        },
        "mesh": {
          "description": "Relative path of the mesh file.",
          "type": "string"
        },
        "mips": {
          "description": "Mip levels of the textures.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "normal": {
          "description": "Relative path of the normal texture.",
          "type": "string"
        },
        "step": {
          "description": "Sampling step in cells.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "texture_size": {
          "description": "Width and height of the diffuse texture.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "maxItems": 2,
          "minItems": 2
        },
        "triangles": {
          "description": "Triangles of the block mesh.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "vertices": {
          "description": "Vertices of the block mesh.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "x": {
          "description": "Cell x of the south-west cell.",
          "type": "integer",
          "format": "int32"
        },
        "y": {
          "description": "Cell y of the south-west cell.",
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "level",
        "x",
        "y",
        "step",
        "vertices",
        "triangles",
        "max_error",
        "mesh",
        "diffuse",
        "normal",
        "texture_size",
        "mips"
      ]
    },
    "ToolInfo": {
      "description": "The tool that produced a document.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Always `lodwright`.",
          "type": "string"
        },
        "version": {
          "description": "The tool version (`SemVer`, see `VERSIONING.md`).",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "WorldPlan": {
      "description": "The plan of one world.",
      "type": "object",
      "properties": {
        "blocks": {
          "description": "The blocks; present only when asked for with `--blocks`.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/PlannedBlock"
          }
        },
        "bounds": {
          "description": "Cell bounds; omitted for a world without cells.",
          "anyOf": [
            {
              "$ref": "#/$defs/Bounds"
            },
            {
              "type": "null"
            }
          ]
        },
        "cells": {
          "description": "Cells with terrain.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "form_id": {
          "description": "Absolute form id, eight upper-case hex digits.",
          "type": "string"
        },
        "levels": {
          "description": "One entry per level.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/LevelPlan"
          }
        },
        "max_seam_error": {
          "description": "Largest height difference across a shared cell edge, in world units.",
          "type": "number",
          "format": "double"
        },
        "name": {
          "description": "Editor id of the world.",
          "type": "string"
        },
        "settings_path": {
          "description": "Relative path of the LOD settings file.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "form_id",
        "cells",
        "max_seam_error",
        "settings_path",
        "levels"
      ]
    }
  }
}
